# Public backend endpoint for the authenticated Fastify API (docs/API_CONTRACT.md).
# This is a public host, never a provider credential or signing secret.
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid

# Supabase Auth (docs/API_CONTRACT.md). Use the project URL and the publishable
# key only, never the secret or service-role key. Put real values in .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
