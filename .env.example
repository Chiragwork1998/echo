# Public, non-secret client config only. Everything EXPO_PUBLIC_* ships inside the app bundle.
EXPO_PUBLIC_API_URL=

# Voice transcription API. The token ships in the app, so it only stops casual abuse.
EXPO_PUBLIC_VOICE_URL=
EXPO_PUBLIC_VOICE_TOKEN=

# ECHO Plus. RevenueCat's public SDK keys (Project settings, API keys). Left empty, Plus is
# unavailable and every Plus feature stays open. The test key (test_...) is RevenueCat's Test Store
# and works in development builds only: a release build refuses it.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
