# Placeholders only. Use the server-side Supabase session-pooler URI and keep
# the real password in a local/deployment secret store.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_AUTH_API_KEY=SUPABASE_PUBLISHABLE_KEY
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Server-only companion credentials. Never expose these in an Expo public variable.
# OPENAI_API_KEY=replace-with-a-server-side-project-key
ECHO_COMPANION_MODEL=gpt-5.6-luna
# When set, DeepSeek replaces OpenAI. DEEPSEEK_MODEL defaults to deepseek-flash (DeepSeek V4.1 Flash).
# DEEPSEEK_API_KEY=replace-with-server-only-key
# DEEPSEEK_MODEL=deepseek-flash
ECHO_COMPANION_LOCAL_GUEST=false
# Optional exact browser origins, comma-separated. Never use a wildcard.
# ECHO_COMPANION_ORIGINS=https://your-client.example
