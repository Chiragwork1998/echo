{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "generate:assets": "node scripts/generate-design-assets.mjs",
    "visual": "node scripts/visual/compare.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "agent:setup": "bash scripts/agent-setup.sh"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@handoff/(.*)$": "<rootDir>/product-handoff/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.artifacts/",
      "/dist/",
      "<rootDir>/.claude/",
      "<rootDir>/voice-api/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
