{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@handoff/*": ["./product-handoff/*"]
    },
    "types": ["jest", "node"]
  },
  "include": ["app", "src", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
