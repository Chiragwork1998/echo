{
  "expo": {
    "name": "ECHO",
    "slug": "echo",
    "scheme": "echo",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#13263A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font", "expo-image", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
